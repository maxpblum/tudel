  "lessons": [
    {
      "id": "fx.waveforms.lesson",
      "title": "Four waveforms",
      "skill": "fx.waveforms",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Strudel has four basic oscillator waveforms. Think of them as organ stops: same pitch, different colour.</p>"
        },
        {
          "kind": "play",
          "label": "Sawtooth",
          "showCode": true,
          "snippet": {
            "code": "note(\"c3 e3 g3\").s(\"sawtooth\")",
            "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3 e3 g3&quot;).s(&quot;sawtooth&quot;)</code></pre>",
            "needsNetwork": false
          }
        },
        {
          "kind": "play",
          "label": "Mystery sound",
          "showCode": false,
          "snippet": {
            "code": "note(\"c3 e3 g3\").s(\"square\")",
            "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3 e3 g3&quot;).s(&quot;square&quot;)</code></pre>",
            "needsNetwork": false
          }
        },
        {
          "kind": "code",
          "snippet": {
            "code": "note(\"c3\").s(\"triangle\")",
            "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3&quot;).s(&quot;triangle&quot;)</code></pre>",
            "needsNetwork": false
          }
        },
        {
          "kind": "abc",
          "abc": "X:1\nM:4/4\nL:1/4\nK:C clef=bass\nC, E, G, z|"
        },
        {
          "kind": "diagram",
          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"40\"><rect x=\"1\" y=\"5\" width=\"60\" height=\"30\" fill=\"none\" stroke=\"currentColor\"/><text x=\"10\" y=\"25\" font-size=\"12\" fill=\"currentColor\">osc</text><line x1=\"61\" y1=\"20\" x2=\"120\" y2=\"20\" stroke=\"currentColor\"/><text x=\"125\" y=\"25\" font-size=\"12\" fill=\"currentColor\">out</text></svg>"
        },
        {
          "kind": "bridge",
          "title": "From the organ loft",
          "blocks": [
            {
              "kind": "html",
              "html": "<p>A waveform is like a registration: an 8′ flute versus an 8′ reed.</p>"
            }
          ]
        },
        {
          "kind": "compare",
          "diff": "s \"sine\" → \"sawtooth\"",
          "a": {
            "label": "Sine",
            "snippet": {
              "code": "note(\"c3\").s(\"sine\")",
              "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3&quot;).s(&quot;sine&quot;)</code></pre>",
              "needsNetwork": false
            }
          },
          "b": {
            "label": "Sawtooth",
            "snippet": {
              "code": "note(\"c3\").s(\"sawtooth\")",
              "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3&quot;).s(&quot;sawtooth&quot;)</code></pre>",
              "needsNetwork": false
            }
          }
        }
      ],
      "text": "Strudel has four basic oscillator waveforms."
    },
    {
      "id": "fx.lowpass.lesson",
      "title": "The low-pass filter",
      "skill": "fx.lowpass",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>A low-pass filter removes frequencies above its <code>lpf</code> cutoff.</p>"
        },
        {
          "kind": "filter",
          "type": "lowpass",
          "curves": [
            {
              "cutoff": 800,
              "q": 1
            }
          ]
        },
        {
          "kind": "filter",
          "type": "lowpass",
          "title": "Same cutoff (800 Hz), different resonance",
          "curves": [
            {
              "cutoff": 800,
              "q": 1,
              "label": "lpq 1 (default)"
            },
            {
              "cutoff": 800,
              "q": 10,
              "label": "lpq 10"
            },
            {
              "cutoff": 800,
              "q": 18,
              "label": "lpq 18"
            }
          ]
        },
        {
          "kind": "signal",
          "shape": "sine",
          "min": 200,
          "max": 2000,
          "period": 4,
          "cycles": 8,
          "label": "lpf sweep"
        },
        {
          "kind": "compare",
          "diff": "lpf 400 → 2000",
          "a": {
            "label": "Dark",
            "snippet": {
              "code": "note(\"c3 e3 g3\").s(\"sawtooth\").lpf(400)",
              "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3 e3 g3&quot;).s(&quot;sawtooth&quot;).lpf(400)</code></pre>",
              "needsNetwork": false
            }
          },
          "b": {
            "label": "Bright",
            "snippet": {
              "code": "note(\"c3 e3 g3\").s(\"sawtooth\").lpf(2000)",
              "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3 e3 g3&quot;).s(&quot;sawtooth&quot;).lpf(2000)</code></pre>",
              "needsNetwork": false
            }
          }
        }
      ],
      "text": "A low-pass filter removes frequencies above its cutoff."
    },
    {
      "id": "fx.envelope.lesson",
      "title": "ADSR",
      "skill": "fx.envelope",
      "blocks": [
        {
          "kind": "html",
          "html": "<p>Attack, decay, sustain and release shape the loudness of each note.</p>"
        },
        {
          "kind": "envelope",
          "attack": 0.3,
          "decay": 0.2,
          "sustain": 0.6,
          "release": 0.5,
          "hold": 1
        },
        {
          "kind": "play",
          "label": "Slow attack",
          "showCode": true,
          "snippet": {
            "code": "note(\"c3\").s(\"sawtooth\").attack(0.5)",
            "html": "<pre class=\"shiki fixture\"><code>note(&quot;c3&quot;).s(&quot;sawtooth&quot;).attack(0.5)</code></pre>",
            "needsNetwork": false
          }
        }
      ],
      "text": "Attack, decay, sustain and release shape the loudness of each note."
    },
